# Postgres (NMDPRA data + Airflow)
POSTGRES_USER=nmdpra
POSTGRES_PASSWORD=nmdpra_secret
POSTGRES_DB=nmdpra_data
POSTGRES_PORT=5432

# Airflow DB (same Postgres; use separate DB in prod)
AIRFLOW_DB=airflow

# API
# Local Docker / Postgres:
DATABASE_URL=postgresql+psycopg2://nmdpra:nmdpra_secret@localhost:5432/nmdpra_data
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Supabase (Vercel / production) — set these on the `api` service only.
# Prefer pasting the connection URI from Supabase → Project Settings → Database.
# Use Session mode (port 5432) or Transaction pooler (6543) as needed.
# Do not commit real passwords. Vercel injects secrets at runtime.
# ---------------------------------------------------------------------------
# Option A — full URI (recommended). postgres:// and postgresql:// both work;
# the API normalizes to postgresql+psycopg2 and adds sslmode=require for *.supabase.co.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
# Or alias:
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Option B — discrete parts (used only if DATABASE_URL / SUPABASE_DB_URL are unset)
# SUPABASE_DB_HOST=db.[PROJECT_REF].supabase.co
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_SSLMODE=require

# Optional Supabase project metadata (not required for SQLAlchemy queries)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# Airflow (for admin pipeline trigger; from API container use airflow-webserver:8080)
AIRFLOW_API_BASE=http://localhost:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
# Required for Run pipeline button; set a long random secret. Never expose in client.
ADMIN_RUN_TOKEN=change-me-long-random

# Next.js (browser → API). Docker Compose also passes API_URL / BACKEND_API_URL for server routes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel Services: do NOT set API_URL in the Vercel dashboard when using bindings.
# Root vercel.json injects API_URL into the `web` service as a binding to `api`.
# Browser traffic uses same-origin public paths (/v1/*, /health, /api/v1/tanna/*).
# Optional browser override (usually leave unset on Vercel):
# NEXT_PUBLIC_API_URL=

# MinIO (optional)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# NMDPRA source base URL
NMDPRA_BASE_URL=https://www.nmdpra.gov.ng

# Parser / DQ
PARSER_VERSION=1.0.0
DQ_ERROR_THRESHOLD_PCT=5
DQ_WARN_THRESHOLD_PCT=10
